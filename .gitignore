# Publish only the main paper's reproducibility files.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/requirements-inference.txt
!/src/
/src/*
!/src/01_build_filings.py
!/src/02_build_processed.py
!/src/03_build_chunks.py
!/src/run_c0_model.py
!/src/run_stress.py
!/src/policy_engine.py
!/src/judge_claims.py
!/src/evaluation.py
!/policies/
/policies/*
!/policies/policies_v1.yaml
!/analysis/
/analysis/*
!/analysis/paper_analysis.ipynb
!/analysis/run_notebook.py
!/analysis/paper_numbers.md
!/analysis/tables/
/analysis/tables/*
!/analysis/tables/table*.tex
!/analysis/tables/table2_main.csv
!/analysis/tables/metrics_by_scenario.csv
!/analysis/tables/judge_agreement.csv
!/analysis/tables/robustness_by_judge.csv
!/analysis/tables/random_withholding_baseline.csv
!/analysis/tables/stress_summary.csv
!/analysis/tables/stress_by_template.csv
!/data/
/data/*
!/data/dataset_manifest.csv
!/data/filing_manifest.csv
!/data/chunks/
/data/chunks/*
!/data/chunks/*_FY2025.jsonl
!/data/generated/
/data/generated/*
!/data/generated/C0/
!/data/generated/C1/
!/data/generated/C2/
!/data/generated/S0-*/
!/data/generated/S1-*/
/data/generated/C2/*/*
!/data/generated/C2/*/policy_audit.jsonl

# Credentials and temporary files, including within allowed directories.
.env
.env.*
*.pem
*.key
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.log
